# Copiar a .env.local y llenar. .env.local está en .gitignore.

NEXT_PUBLIC_SUPABASE_URL=

# Llave pública (nuevo formato de Supabase; reemplaza la anon key).
# Se exponen los dos nombres a propósito: mismo valor, para que ningún
# código se rompa según cuál espere.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secreta: se salta RLS. Solo para scripts locales y para el servidor,
# NUNCA en el navegador. También aquí se exponen los dos nombres.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Correo — avisos internos: menciones del foro e inventario bajo
# ─────────────────────────────────────────────────────────────

# SMTP de la cuenta de Gmail del negocio. Sin estas dos la aplicación
# funciona igual y los avisos simplemente no salen: un correo caído no
# puede tumbar una operación.
#
# SMTP_PASSWORD NO es la contraseña de la cuenta: es una contraseña de
# aplicación de 16 caracteres. Google Account → Seguridad → Verificación
# en 2 pasos → Contraseñas de aplicaciones.
SMTP_USER=
SMTP_PASSWORD=

# Opcionales: por defecto smtp.gmail.com y 465.
SMTP_HOST=
SMTP_PORT=

# Remitente. Gmail exige que coincida con SMTP_USER o con un alias suyo;
# si no, reescribe el encabezado. Si se deja vacío se usa SMTP_USER.
EMAIL_FROM="Toromana <finca@ejemplo.com>"

# Base de los enlaces de los correos. En Vercel se deduce sola.
NEXT_PUBLIC_APP_URL=

# Solo en producción. Protege /api/cron/inventario, que si no queda abierto
# a internet y cualquiera puede provocar correos. Vercel lo manda como
# 'Authorization: Bearer <secreto>' en sus llamadas programadas.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Migraciones — SOLO local. Esta no va a Vercel.
# ─────────────────────────────────────────────────────────────

# La aplicación nunca lee esta variable: solo sirve para correr los .sql de
# supabase/migrations/ con psql. La service role key no alcanza —PostgREST
# lee y escribe filas, pero no ejecuta DDL.
#
# Supabase → Project Settings → Database → Connection string → Session pooler.
# Entre comillas, y con los caracteres especiales de la clave codificados
# (@ → %40), o la cadena se parte donde no es.
SUPABASE_DB_URL="postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres"
